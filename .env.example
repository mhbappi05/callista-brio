# Frontend (exposed to the browser -- never put privileged secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets: set these as Supabase Edge Function secrets, NOT in this file
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
# Public address of the store, no trailing slash. Used for canonical links, the sitemap and sharing tags.
VITE_SITE_URL=http://localhost:5173
# Optional: absolute URL of a default share image (1200x630)
VITE_DEFAULT_OG_IMAGE=